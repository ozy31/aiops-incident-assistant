# Copy to .env (never commit it). All settings use the AIOPS_ prefix except the
# Anthropic SDK's own ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
AIOPS_LLM_PROVIDER=anthropic
AIOPS_ANTHROPIC_MODEL=claude-opus-5-5
AIOPS_LOKI_URL=http://localhost:3100
AIOPS_PROMETHEUS_URL=http://localhost:9090
# AIOPS_ELASTICSEARCH_URL=http://localhost:9200
# AIOPS_SLACK_WEBHOOK_URL=
# AIOPS_WEBHOOK_TOKEN=
# Local model via an OpenAI-compatible server (e.g. Ollama):
# AIOPS_LLM_PROVIDER=openai
# AIOPS_OPENAI_BASE_URL=http://localhost:11434/v1
# AIOPS_OPENAI_MODEL=llama3.1:8b
